# APIキーの置き場所。このファイルをコピーして .env を作る。
#   cp .env.example .env
# .env は .gitignore 済み。コミットしないこと。
#
# **キーを分けても残高は分かれない。** クレジットは組織単位なので、
# evalで使い切ると同じ組織の本番アプリ（案1）が止まる。2026-08-19 に実際に起きた。
# 実際に守るには Anthropic Console でワークスペースを分け、
# そちらに上限額を設定すること。キーを分けるのは使用量の内訳を見るため。

# 列D。Anthropic Console で発行。Development ワークスペースのキーを推奨。
ANTHROPIC_API_KEY=

# 列C。https://deepinfra.com で発行。
DEEPINFRA_API_KEY=
