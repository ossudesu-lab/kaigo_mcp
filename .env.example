# APIキーの置き場所。このファイルをコピーして .env を作る。
#   cp .env.example .env
# .env は .gitignore 済み。コミットしないこと。
#
# **キーを分けても残高は分かれない。** クレジットは組織単位なので、
# evalで使い切ると同じ組織の本番アプリ（案1）が止まる。2026-08-19 に実際に起きた。
# 実際に守るには Anthropic Console でワークスペースを分け、
# そちらに上限額を設定すること。キーを分けるのは使用量の内訳を見るため。

# 列D。Anthropic Console で発行。Development ワークスペースのキーを推奨。
ANTHROPIC_API_KEY=

# 列C。https://build.nvidia.com で発行（nvapi- で始まる）。
# クレカ不要・無料。ただしクレジット制（初期1,000程度）なので無制限ではない。
NVIDIA_API_KEY=

# 列Cの代替。https://deepinfra.com で発行。同じモデルを有料で使う。
# NVIDIA が詰まったとき用。カード登録が要る場合がある。
DEEPINFRA_API_KEY=

# 使用量の記録（credit_watch）。列D（Anthropic）の呼び出しごとにトークン数だけを記録する。
# 1つでも空なら記録しない。値は Vercel の kaigo_matching の環境変数と同じもの。
KV_REST_API_URL=
KV_REST_API_TOKEN=
CW_PROJECT=kaigo_mcp
CW_PURPOSE=eval
